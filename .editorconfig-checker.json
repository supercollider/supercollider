{
  "Verbose": false,
  "Debug": false,
  "IgnoreDefaults": false,
  "SpacesAfterTabs": false,
  "NoColor": false,
  "Exclude": [
    "\\.sc",
    "\\.schelp",
    "\\.h",
    "\\.hpp",
    "\\.cpp",
    "\\.yaml",
    "\\.yml",
    "\\.json",
    "\\.js",
    "\\.rc",
    "\\.nib",
    "\\.rtf",
    "\\.l"
  ],
  "AllowedContentTypes": [],
  "PassedFiles": [],
  "Disable": {
    "EndOfLine": false,
    "Indentation": false,
    "IndentSize": false,
    "InsertFinalNewline": false,
    "TrimTrailingWhitespace": false,
    "MaxLineLength": false,
    "Charset": false
  }
}
