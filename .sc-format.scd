// The SuperCollider style guide, github.com/supercollider/supercollider/wiki/Style-Guidelines:-SuperCollider, with
// the spacing its examples use. A directory can have its own options file, e.g., examples/.
(
	final_newline: \one,
	trailing_whitespace: \remove,
	unicode_spaces: \ascii,
	indent: \tab,
	region_brackets: \own_lines,
	region_semicolons: \insert,
	space: (
		around_binary_operators: \one,
		around_keyword_operators: \one,
		around_assignment: \one,
		after_comma: \one,
		before_comma: \none,
		before_semicolon: \none,
		inside_braces: \one,
		before_parameters: \one,
		after_parameters: \one,
		inside_parens: \none,
		inside_brackets: \none,
		inside_pipes: \none,
		around_parameter_equals: \one,
		after_key: \one,
		around_dot: \none,
		before_control_paren: \none,
		before_closure: \one,
	),
	kr: \on,
	parameters: \on,
	multiline: (arrays: \one_per_line),
	final_semicolon: \remove,
	trailing_closures: \control,
	control_prefix: \on,
)
