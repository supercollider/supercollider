   16 classOrExtList.item: class
   17                    | class.extension

   18 class: CLASSNAME class.slot.opt class.super.opt OPENCURLY members.opt method.list.opt CLOSECURLY

   19 class.super.opt: ε
   20                | COLON CLASSNAME

   21 class.slot.opt: ε
   22               | OPENSQUARE name CLOSESQUARE

   23 class.extension: ADD CLASSNAME OPENCURLY method.list.opt CLOSECURLY

   24 members.entry.item: accessor variable_declarations.list.item

   25 members.entry.list: members.entry.item
   26                   | members.entry.list COMMA members.entry.item

   27 members.entry: CLASSVAR members.entry.list
   28              | VAR members.entry.list
   29              | CONST members.entry.list

   30 members: members.entry
   31        | members SEMICOLON members.entry

   32 members.opt: ε
   33            | members semicolon.opt

   34 method.name: name
   35            | binary_op.raw

   36 method.base: method.name OPENCURLY argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   37            | method.name OPENCURLY argument_declarations.opt CLOSECURLY
