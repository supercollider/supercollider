Terminals unused in grammar

    BADTOKEN
    LEXER_ERROR


Grammar

    0 $accept: go $end

    1 go: region semicolon.opt $end
    2   | INTERPRET $end
    3   | file_as_func
    4   | interpreted_function
    5   | classOrExtList.list $end
    6   | ε

    7 file_as_func: INTERPRET argument_declarations block.contents semicolon.opt $end
    8             | INTERPRET variable_declarations SEMICOLON block.contents semicolon.opt $end
    9             | INTERPRET variable_declarations semicolon.opt $end

   10 interpreted_function: INTERPRET_FUNCTION block.contents semicolon.opt $end
   11                     | INTERPRET_FUNCTION semicolon.opt $end
   12                     | INTERPRET_FUNCTION OPENPAREN variable_declarations SEMICOLON block.contents semicolon.opt CLOSEPAREN $end
   13                     | INTERPRET_FUNCTION OPENPAREN variable_declarations semicolon.opt CLOSEPAREN $end

   14 region.item: expr
   15            | NONLOCALRETURN expr
   16            | OPENPAREN argument_declarations block.contents semicolon.opt CLOSEPAREN
   17            | OPENPAREN argument_declarations CLOSEPAREN
   18            | OPENPAREN variable_declarations SEMICOLON block.contents semicolon.opt CLOSEPAREN

   19 region: INTERPRET region.item
   20       | INTERPRET error
   21       | region SEMICOLON region.item
   22       | region REGION_SEPARATOR region.item
   23       | region error

   24 classOrExtList.list: classOrExtList.item
   25                    | classOrExtList.list classOrExtList.item

   26 classOrExtList.item: class
   27                    | class.extension

   28 class: CLASSNAME class.slot.opt class.super.opt OPENCURLY members.opt method.list.opt CLOSECURLY

   29 class.super.opt: ε
   30                | COLON CLASSNAME

   31 class.slot.opt: ε
   32               | OPENSQUARE name CLOSESQUARE
   33               | OPENSQUARE CLOSESQUARE

   34 class.extension: ADD CLASSNAME OPENCURLY method.list.opt CLOSECURLY

   35 members.entry.item: accessor variable_declarations.list.item

   36 members.entry.list: members.entry.item
   37                   | members.entry.list COMMA members.entry.item

   38 members.entry: CLASSVAR members.entry.list
   39              | VAR members.entry.list
   40              | CONST members.entry.list

   41 members: members.entry
   42        | members SEMICOLON members.entry

   43 members.opt: ε
   44            | members semicolon.opt

   45 method.name: name
   46            | binary_op.raw

   47 method.base: method.name OPENCURLY argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   48            | method.name OPENCURLY argument_declarations.opt CLOSECURLY
   49            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt block.contents semicolon.opt CLOSECURLY
   50            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt CLOSECURLY
   51            | method.name OPENCURLY error

   52 method: method.base
   53       | MULTIPLY method.base

   54 method.list: method
   55            | method.list method

   56 method.list.opt: ε
   57                | method.list

   58 block.open: OPENCURLY
   59           | BEGINCLOSEDFUNC

   60 block: block.open argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   61      | block.open argument_declarations.opt CLOSECURLY

   62 block.opt_list: ε
   63               | block.list

   64 block.list: block
   65           | generator
   66           | block.list block
   67           | block.list generator

   68 block.contents: block.contents.item
   69               | block.contents SEMICOLON block.contents.item
   70               | block.contents NONLOCALRETURN expr
   71               | block.contents SEMICOLON NONLOCALRETURN expr
   72               | NONLOCALRETURN expr

   73 block.contents.item: expr
   74                    | variable_declarations

   75 adverb: DOT name
   76       | DOT integer
   77       | DOT OPENPAREN expr_or_seq CLOSEPAREN

   78 binary_op.raw: BINOP
   79              | READWRITEVAR
   80              | LESSTHAN
   81              | GREATERTHAN
   82              | MINUS
   83              | MULTIPLY
   84              | ADD
   85              | PIPE

   86 binary_op.no_adverb: binary_op.raw
   87                    | KEYBINOP

   88 binary_op: binary_op.no_adverb adverb
   89          | binary_op.no_adverb

   90 msgsend: OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN arguments CLOSEPAREN block.opt_list
   91        | OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN CLOSEPAREN block.list
   92        | OPENPAREN binary_op.no_adverb CLOSEPAREN block.list
   93        | name OPENPAREN arguments CLOSEPAREN block.opt_list
   94        | name OPENPAREN CLOSEPAREN block.list
   95        | name block.list
   96        | expr DOT name arguments.maybe_paren block.opt_list
   97        | expr DOT arguments.paren block.opt_list
   98        | expr DOT OPENPAREN CLOSEPAREN block.opt_list
   99        | CLASSNAME OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
  100        | CLASSNAME block.list
  101        | CLASSNAME arguments.paren block.opt_list
  102        | CLASSNAME OPENPAREN CLOSEPAREN block.opt_list

  103 expr.dotrange: expr DOT OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE
  104              | expr DOT OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE
  105              | expr DOT OPENSQUARE arguments DOTDOT CLOSESQUARE

  106 expr.dotrange.assign: expr DOT OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr
  107                     | expr DOT OPENSQUARE arguments DOTDOT CLOSESQUARE EQUALSSIGN expr
  108                     | expr DOT OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr

  109 expr.base.range: expr.base OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE
  110                | expr.base OPENSQUARE arguments DOTDOT CLOSESQUARE
  111                | expr.base OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE

  112 expr.base.range.assign: expr.base OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr
  113                       | expr.base OPENSQUARE arguments DOTDOT CLOSESQUARE EQUALSSIGN expr
  114                       | expr.base OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr

  115 range: OPENPAREN expr_or_seq DOTDOT CLOSEPAREN
  116      | OPENPAREN expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  117      | OPENPAREN expr_or_seq COMMA expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  118      | OPENPAREN expr_or_seq COMMA expr_or_seq DOTDOT CLOSEPAREN
  119      | OPENPAREN DOTDOT expr_or_seq CLOSEPAREN

  120 range.generator: OPENPAREN COLON expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  121                | OPENPAREN COLON expr_or_seq COMMA expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  122                | OPENPAREN COLON expr_or_seq COMMA expr_or_seq DOTDOT CLOSEPAREN
  123                | OPENPAREN COLON DOTDOT expr_or_seq CLOSEPAREN
  124                | OPENPAREN COLON expr_or_seq DOTDOT CLOSEPAREN

  125 expr.base: literal
  126          | generator
  127          | name
  128          | CURRYARG
  129          | msgsend
  130          | OPENPAREN expr_or_seq CLOSEPAREN
  131          | OPENPAREN error
  132          | TILDE name
  133          | expr.base OPENSQUARE arguments CLOSESQUARE
  134          | expr.base OPENSQUARE CLOSESQUARE
  135          | expr.base.range
  136          | range
  137          | range.generator

  138 expr: expr.base
  139     | expr.base.range.assign
  140     | expr.dotrange
  141     | expr.dotrange.assign
  142     | expr DOT OPENSQUARE arguments CLOSESQUARE
  143     | expr DOT OPENSQUARE CLOSESQUARE
  144     | expr binary_op expr
  145     | expr DOT name EQUALSSIGN expr
  146     | CLASSNAME
  147     | BACKTICK expr
  148     | name EQUALSSIGN expr
  149     | TILDE name EQUALSSIGN expr
  150     | name OPENPAREN arguments CLOSEPAREN EQUALSSIGN expr
  151     | name.pack EQUALSSIGN expr
  152     | name.pack OPENPAREN expr_or_seq CLOSEPAREN
  153     | expr.base OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
  154     | expr.base OPENSQUARE CLOSESQUARE EQUALSSIGN expr
  155     | expr DOT OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
  156     | expr DOT OPENSQUARE CLOSESQUARE EQUALSSIGN expr

  157 expr_or_seq.base: expr
  158                 | expr_or_seq.base SEMICOLON expr

  159 expr_or_seq: expr_or_seq.base semicolon.opt

  160 generator: OPENCURLY COLON expr_or_seq COMMA generator.qual.list comma.opt CLOSECURLY
  161          | OPENCURLY SEMICOLON expr_or_seq COMMA generator.qual.list comma.opt CLOSECURLY

  162 generator.qual.list: generator.qual
  163                    | generator.qual.list COMMA generator.qual

  164 generator.qual: name LEFTARROW expr_or_seq
  165               | name name LEFTARROW expr_or_seq
  166               | VAR name EQUALSSIGN expr_or_seq
  167               | VAR name OPENPAREN expr_or_seq CLOSEPAREN
  168               | expr_or_seq
  169               | COLON COLON expr_or_seq
  170               | COLON WHILE expr_or_seq

  171 argument_declarations.list: name
  172                           | name EQUALSSIGN expr
  173                           | name OPENPAREN expr_or_seq CLOSEPAREN
  174                           | argument_declarations.list COMMA name
  175                           | argument_declarations.list COMMA name EQUALSSIGN expr
  176                           | argument_declarations.list COMMA name OPENPAREN expr_or_seq CLOSEPAREN

  177 argument_declarations.pipelist: name literal
  178                               | name
  179                               | name EQUALSSIGN literal
  180                               | name OPENPAREN expr_or_seq CLOSEPAREN
  181                               | name EQUALSSIGN OPENPAREN expr_or_seq CLOSEPAREN
  182                               | argument_declarations.pipelist comma.opt name literal
  183                               | argument_declarations.pipelist comma.opt name
  184                               | argument_declarations.pipelist comma.opt name EQUALSSIGN literal
  185                               | argument_declarations.pipelist comma.opt name OPENPAREN expr_or_seq CLOSEPAREN
  186                               | argument_declarations.pipelist comma.opt name EQUALSSIGN OPENPAREN expr_or_seq CLOSEPAREN

  187 argument_declarations: ARG SEMICOLON
  188                      | ARG argument_declarations.list comma.opt SEMICOLON
  189                      | ARG argument_declarations.list ELLIPSIS name SEMICOLON
  190                      | ARG argument_declarations.list ELLIPSIS name COMMA name SEMICOLON
  191                      | ARG ELLIPSIS name SEMICOLON
  192                      | ARG ELLIPSIS name COMMA name SEMICOLON
  193                      | PIPE PIPE
  194                      | PIPE argument_declarations.pipelist comma.opt PIPE
  195                      | PIPE argument_declarations.pipelist ELLIPSIS name PIPE
  196                      | PIPE argument_declarations.pipelist ELLIPSIS name COMMA name PIPE
  197                      | PIPE ELLIPSIS name PIPE
  198                      | PIPE ELLIPSIS name COMMA name PIPE

  199 argument_declarations.opt: ε
  200                          | argument_declarations

  201 arguments.entries: KEYBINOP expr_or_seq
  202                  | MULTIPLY expr_or_seq
  203                  | expr_or_seq

  204 arguments.no_trailing: arguments.entries
  205                      | arguments.no_trailing COMMA arguments.entries

  206 arguments: arguments.no_trailing comma.opt

  207 arguments.paren: OPENPAREN arguments CLOSEPAREN

  208 arguments.maybe_paren: ε
  209                      | OPENPAREN CLOSEPAREN
  210                      | OPENPAREN arguments CLOSEPAREN

  211 variable_declarations.list.item: name
  212                                | name EQUALSSIGN expr
  213                                | name OPENPAREN expr_or_seq CLOSEPAREN
  214                                | name.pack EQUALSSIGN expr
  215                                | name.pack OPENPAREN expr_or_seq CLOSEPAREN

  216 variable_declarations.list: variable_declarations.list.item
  217                           | variable_declarations.list COMMA variable_declarations.list.item

  218 variable_declarations: VAR variable_declarations.list

  219 literal.terminal: symbol
  220                 | string
  221                 | integer
  222                 | float
  223                 | boolean
  224                 | nil
  225                 | ascii
  226                 | block

  227 literal.array.contents: ε
  228                       | expr_or_seq
  229                       | expr_or_seq COLON expr_or_seq
  230                       | KEYBINOP expr_or_seq
  231                       | literal.array.contents COMMA expr_or_seq
  232                       | literal.array.contents COMMA expr_or_seq COLON expr_or_seq
  233                       | literal.array.contents COMMA KEYBINOP expr_or_seq

  234 literal.dictionary.entry: expr COLON expr_or_seq
  235                         | KEYBINOP expr_or_seq

  236 literal.dictionary.entries: ε
  237                           | literal.dictionary.entry
  238                           | literal.dictionary.entries COMMA literal.dictionary.entry

  239 literal.dictionary: OPENPAREN literal.dictionary.entries comma.opt CLOSEPAREN

  240 literal.array: OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
  241              | HASH OPENSQUARE literal.array.contents comma.opt CLOSESQUARE

  242 literal: literal.terminal
  243        | literal.array
  244        | literal.dictionary

  245 name: NAME
  246     | WHILE

  247 name.list: HASH name
  248          | HASH TILDE name
  249          | name.list COMMA name
  250          | name.list COMMA TILDE name

  251 name.pack: name.list
  252          | name.list ELLIPSIS name
  253          | name.list ELLIPSIS TILDE name

  254 ascii: ASCII

  255 nil: NIL

  256 boolean: TRUE
  257        | FALSE

  258 symbol: SYMBOL_QUOTE
  259       | SYMBOL_SLASH

  260 string: STRINGLINE
  261       | string STRINGLINE

  262 integer: INTEGER
  263        | INTEGER_RADIX
  264        | HEXADECIMAL
  265        | MINUS integer

  266 float.raw_unsigned: FLOAT
  267                   | FLOAT_RADIX
  268                   | FLOAT_EXPONENT
  269                   | FLOAT_INF

  270 float.raw: float.raw_unsigned
  271          | MINUS float.raw_unsigned

  272 accidental.unsigned: ACCIDENTAL_STEPS
  273                    | ACCIDENTAL_CENTS

  274 accidental: accidental.unsigned
  275           | MINUS accidental.unsigned

  276 float: float.raw
  277      | accidental
  278      | float.raw PI
  279      | integer PI
  280      | PI
  281      | MINUS PI

  282 accessor: ε
  283         | LESSTHAN
  284         | GREATERTHAN
  285         | READWRITEVAR

  286 semicolon.opt: ε
  287              | SEMICOLON

  288 comma.opt: ε
  289          | COMMA


