   39            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt CLOSECURLY

   40 method: method.base
   41       | MULTIPLY method.base

   42 method.list: method
   43            | method.list method

   44 method.list.opt: ε
   45                | method.list

   46 block.open: OPENCURLY
   47           | BEGINCLOSEDFUNC

   48 block: block.open argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   49      | block.open argument_declarations.opt CLOSECURLY

   50 block.opt_list: ε
   51               | block.list

   52 block.list: block
   53           | block.list block

   54 block.contents: block.contents.item
   55               | block.contents SEMICOLON block.contents.item
   56               | block.contents NONLOCALRETURN expr
   57               | block.contents SEMICOLON NONLOCALRETURN expr
   58               | NONLOCALRETURN expr

   59 block.contents.item: expr
   60                    | variable_declarations

   61 adverb: DOT name
   62       | DOT integer
   63       | DOT OPENPAREN expr.seq CLOSEPAREN

   64 binary_op.raw: BINOP
   65              | READWRITEVAR
   66              | LESSTHAN
   67              | GREATERTHAN
   68              | MINUS
   69              | MULTIPLY
   70              | ADD
   71              | PIPE

   72 binary_op.no_adverb: binary_op.raw
