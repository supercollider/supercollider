Terminals unused in grammar

    BADTOKEN
    LEXER_ERROR


Grammar

    0 $accept: go $end

    1 go: region semicolon.opt $end
    2   | INTERPRET $end
    3   | file_as_func
    4   | classOrExtList.list $end
    5   | ε

    6 file_as_func: INTERPRET argument_declarations block.contents semicolon.opt $end
    7             | INTERPRET variable_declarations SEMICOLON block.contents semicolon.opt $end
    8             | INTERPRET variable_declarations semicolon.opt $end

    9 region.item: expr
   10            | NONLOCALRETURN expr
   11            | OPENPAREN argument_declarations block.contents semicolon.opt CLOSEPAREN
   12            | OPENPAREN argument_declarations CLOSEPAREN
   13            | OPENPAREN variable_declarations SEMICOLON block.contents semicolon.opt CLOSEPAREN

   14 region: INTERPRET region.item
   15       | INTERPRET error
   16       | region SEMICOLON region.item
   17       | region REGION_SEPARATOR region.item
   18       | region error

   19 classOrExtList.list: classOrExtList.item
   20                    | classOrExtList.list classOrExtList.item

   21 classOrExtList.item: class
   22                    | class.extension

   23 class: CLASSNAME class.slot.opt class.super.opt OPENCURLY members.opt method.list.opt CLOSECURLY

   24 class.super.opt: ε
   25                | COLON CLASSNAME

   26 class.slot.opt: ε
   27               | OPENSQUARE name CLOSESQUARE
   28               | OPENSQUARE CLOSESQUARE

   29 class.extension: ADD CLASSNAME OPENCURLY method.list.opt CLOSECURLY

   30 members.entry.item: accessor variable_declarations.list.item

   31 members.entry.list: members.entry.item
   32                   | members.entry.list COMMA members.entry.item

   33 members.entry: CLASSVAR members.entry.list
   34              | VAR members.entry.list
   35              | CONST members.entry.list

   36 members: members.entry
   37        | members SEMICOLON members.entry

   38 members.opt: ε
   39            | members semicolon.opt

   40 method.name: name
   41            | binary_op.raw

   42 method.base: method.name OPENCURLY argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   43            | method.name OPENCURLY argument_declarations.opt CLOSECURLY
   44            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt block.contents semicolon.opt CLOSECURLY
   45            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt CLOSECURLY
   46            | method.name OPENCURLY error

   47 method: method.base
   48       | MULTIPLY method.base

   49 method.list: method
   50            | method.list method

   51 method.list.opt: ε
   52                | method.list

   53 block.open: OPENCURLY
   54           | BEGINCLOSEDFUNC

   55 block: block.open argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   56      | block.open argument_declarations.opt CLOSECURLY

   57 block.opt_list: ε
   58               | block.list

   59 block.list: block
   60           | generator
   61           | block.list block
   62           | block.list generator

   63 block.contents: block.contents.item
   64               | block.contents SEMICOLON block.contents.item
   65               | block.contents NONLOCALRETURN expr
   66               | block.contents SEMICOLON NONLOCALRETURN expr
   67               | NONLOCALRETURN expr

   68 block.contents.item: expr
   69                    | variable_declarations

   70 adverb: DOT name
   71       | DOT integer
   72       | DOT OPENPAREN expr_or_seq CLOSEPAREN

   73 binary_op.raw: BINOP
   74              | READWRITEVAR
   75              | LESSTHAN
   76              | GREATERTHAN
   77              | MINUS
   78              | MULTIPLY
   79              | ADD
   80              | PIPE

   81 binary_op.no_adverb: binary_op.raw
   82                    | KEYBINOP

   83 binary_op: binary_op.no_adverb adverb
   84          | binary_op.no_adverb

   85 msgsend: OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN arguments CLOSEPAREN block.opt_list
   86        | OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN CLOSEPAREN block.list
   87        | OPENPAREN binary_op.no_adverb CLOSEPAREN block.list
   88        | name OPENPAREN arguments CLOSEPAREN block.opt_list
   89        | name OPENPAREN CLOSEPAREN block.list
   90        | name block.list
   91        | expr DOT name arguments.maybe_paren block.opt_list
   92        | expr DOT arguments.paren block.opt_list
   93        | expr DOT OPENPAREN CLOSEPAREN block.opt_list
   94        | CLASSNAME OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
   95        | CLASSNAME block.list
   96        | CLASSNAME arguments.paren block.opt_list
   97        | CLASSNAME OPENPAREN CLOSEPAREN block.opt_list

   98 expr.dotrange: expr DOT OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE
   99              | expr DOT OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE
  100              | expr DOT OPENSQUARE arguments DOTDOT CLOSESQUARE

  101 expr.dotrange.assign: expr DOT OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr
  102                     | expr DOT OPENSQUARE arguments DOTDOT CLOSESQUARE EQUALSSIGN expr
  103                     | expr DOT OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr

  104 expr.base.range: expr.base OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE
  105                | expr.base OPENSQUARE arguments DOTDOT CLOSESQUARE
  106                | expr.base OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE

  107 expr.base.range.assign: expr.base OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr
  108                       | expr.base OPENSQUARE arguments DOTDOT CLOSESQUARE EQUALSSIGN expr
  109                       | expr.base OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr

  110 range: OPENPAREN expr_or_seq DOTDOT CLOSEPAREN
  111      | OPENPAREN expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  112      | OPENPAREN expr_or_seq COMMA expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  113      | OPENPAREN expr_or_seq COMMA expr_or_seq DOTDOT CLOSEPAREN
  114      | OPENPAREN DOTDOT expr_or_seq CLOSEPAREN

  115 range.generator: OPENPAREN COLON expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  116                | OPENPAREN COLON expr_or_seq COMMA expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  117                | OPENPAREN COLON expr_or_seq COMMA expr_or_seq DOTDOT CLOSEPAREN
  118                | OPENPAREN COLON DOTDOT expr_or_seq CLOSEPAREN
  119                | OPENPAREN COLON expr_or_seq DOTDOT CLOSEPAREN

  120 expr.base: literal
  121          | generator
  122          | name
  123          | CURRYARG
  124          | msgsend
  125          | OPENPAREN expr_or_seq CLOSEPAREN
  126          | TILDE name
  127          | expr.base OPENSQUARE arguments CLOSESQUARE
  128          | expr.base OPENSQUARE CLOSESQUARE
  129          | expr.base.range
  130          | range
  131          | range.generator

  132 expr: expr.base
  133     | expr.base.range.assign
  134     | expr.dotrange
  135     | expr.dotrange.assign
  136     | expr DOT OPENSQUARE arguments CLOSESQUARE
  137     | expr DOT OPENSQUARE CLOSESQUARE
  138     | expr binary_op expr
  139     | expr DOT name EQUALSSIGN expr
  140     | CLASSNAME
  141     | BACKTICK expr
  142     | name EQUALSSIGN expr
  143     | TILDE name EQUALSSIGN expr
  144     | name OPENPAREN arguments CLOSEPAREN EQUALSSIGN expr
  145     | name.pack EQUALSSIGN expr
  146     | name.pack OPENPAREN expr_or_seq CLOSEPAREN
  147     | expr.base OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
  148     | expr.base OPENSQUARE CLOSESQUARE EQUALSSIGN expr
  149     | expr DOT OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
  150     | expr DOT OPENSQUARE CLOSESQUARE EQUALSSIGN expr

  151 expr_or_seq.base: expr
  152                 | expr_or_seq.base SEMICOLON expr

  153 expr_or_seq: expr_or_seq.base semicolon.opt

  154 generator: OPENCURLY COLON expr_or_seq COMMA generator.qual.list comma.opt CLOSECURLY
  155          | OPENCURLY SEMICOLON expr_or_seq COMMA generator.qual.list comma.opt CLOSECURLY

  156 generator.qual.list: generator.qual
  157                    | generator.qual.list COMMA generator.qual

  158 generator.qual: name LEFTARROW expr_or_seq
  159               | name name LEFTARROW expr_or_seq
  160               | VAR name EQUALSSIGN expr_or_seq
  161               | VAR name OPENPAREN expr_or_seq CLOSEPAREN
  162               | expr_or_seq
  163               | COLON COLON expr_or_seq
  164               | COLON WHILE expr_or_seq

  165 argument_declarations.list: name
  166                           | name EQUALSSIGN expr
  167                           | name OPENPAREN expr_or_seq CLOSEPAREN
  168                           | argument_declarations.list COMMA name
  169                           | argument_declarations.list COMMA name EQUALSSIGN expr
  170                           | argument_declarations.list COMMA name OPENPAREN expr_or_seq CLOSEPAREN

  171 argument_declarations.pipelist: name literal
  172                               | name
  173                               | name EQUALSSIGN literal
  174                               | name OPENPAREN expr_or_seq CLOSEPAREN
  175                               | name EQUALSSIGN OPENPAREN expr_or_seq CLOSEPAREN
  176                               | argument_declarations.pipelist comma.opt name literal
  177                               | argument_declarations.pipelist comma.opt name
  178                               | argument_declarations.pipelist comma.opt name EQUALSSIGN literal
  179                               | argument_declarations.pipelist comma.opt name OPENPAREN expr_or_seq CLOSEPAREN
  180                               | argument_declarations.pipelist comma.opt name EQUALSSIGN OPENPAREN expr_or_seq CLOSEPAREN

  181 argument_declarations: ARG SEMICOLON
  182                      | ARG argument_declarations.list comma.opt SEMICOLON
  183                      | ARG argument_declarations.list ELLIPSIS name SEMICOLON
  184                      | ARG argument_declarations.list ELLIPSIS name COMMA name SEMICOLON
  185                      | ARG ELLIPSIS name SEMICOLON
  186                      | ARG ELLIPSIS name COMMA name SEMICOLON
  187                      | PIPE PIPE
  188                      | PIPE argument_declarations.pipelist comma.opt PIPE
  189                      | PIPE argument_declarations.pipelist ELLIPSIS name PIPE
  190                      | PIPE argument_declarations.pipelist ELLIPSIS name COMMA name PIPE
  191                      | PIPE ELLIPSIS name PIPE
  192                      | PIPE ELLIPSIS name COMMA name PIPE

  193 argument_declarations.opt: ε
  194                          | argument_declarations

  195 arguments.entries: KEYBINOP expr_or_seq
  196                  | MULTIPLY expr_or_seq
  197                  | expr_or_seq

  198 arguments.no_trailing: arguments.entries
  199                      | arguments.no_trailing COMMA arguments.entries

  200 arguments: arguments.no_trailing comma.opt

  201 arguments.paren: OPENPAREN arguments CLOSEPAREN

  202 arguments.maybe_paren: ε
  203                      | OPENPAREN CLOSEPAREN
  204                      | OPENPAREN arguments CLOSEPAREN

  205 variable_declarations.list.item: name
  206                                | name EQUALSSIGN expr
  207                                | name OPENPAREN expr_or_seq CLOSEPAREN
  208                                | name.pack EQUALSSIGN expr
  209                                | name.pack OPENPAREN expr_or_seq CLOSEPAREN

  210 variable_declarations.list: variable_declarations.list.item
  211                           | variable_declarations.list COMMA variable_declarations.list.item

  212 variable_declarations: VAR variable_declarations.list

  213 literal.terminal: symbol
  214                 | string
  215                 | integer
  216                 | float
  217                 | boolean
  218                 | nil
  219                 | ascii
  220                 | block

  221 literal.array.contents: ε
  222                       | expr_or_seq
  223                       | expr_or_seq COLON expr_or_seq
  224                       | KEYBINOP expr_or_seq
  225                       | literal.array.contents COMMA expr_or_seq
  226                       | literal.array.contents COMMA expr_or_seq COLON expr_or_seq
  227                       | literal.array.contents COMMA KEYBINOP expr_or_seq

  228 literal.dictionary.entry: expr COLON expr_or_seq
  229                         | KEYBINOP expr_or_seq

  230 literal.dictionary.entries: ε
  231                           | literal.dictionary.entry
  232                           | literal.dictionary.entries COMMA literal.dictionary.entry

  233 literal.dictionary: OPENPAREN literal.dictionary.entries comma.opt CLOSEPAREN

  234 literal.array: OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
  235              | HASH OPENSQUARE literal.array.contents comma.opt CLOSESQUARE

  236 literal: literal.terminal
  237        | literal.array
  238        | literal.dictionary

  239 name: NAME
  240     | WHILE

  241 name.list: HASH name
  242          | HASH TILDE name
  243          | name.list COMMA name
  244          | name.list COMMA TILDE name

  245 name.pack: name.list
  246          | name.list ELLIPSIS name
  247          | name.list ELLIPSIS TILDE name

  248 ascii: ASCII

  249 nil: NIL

  250 boolean: TRUE
  251        | FALSE

  252 symbol: SYMBOL_QUOTE
  253       | SYMBOL_SLASH

  254 string: STRINGLINE
  255       | string STRINGLINE

  256 integer: INTEGER
  257        | INTEGER_RADIX
  258        | HEXADECIMAL
  259        | MINUS integer

  260 float.raw_unsigned: FLOAT
  261                   | FLOAT_RADIX
  262                   | FLOAT_EXPONENT
  263                   | FLOAT_INF

  264 float.raw: float.raw_unsigned
  265          | MINUS float.raw_unsigned

  266 accidental.unsigned: ACCIDENTAL_STEPS
  267                    | ACCIDENTAL_CENTS

  268 accidental: accidental.unsigned
  269           | MINUS accidental.unsigned

  270 float: float.raw
  271      | accidental
  272      | float.raw PI
  273      | integer PI
  274      | PI
  275      | MINUS PI

  276 accessor: ε
  277         | LESSTHAN
  278         | GREATERTHAN
  279         | READWRITEVAR

  280 semicolon.opt: ε
  281              | SEMICOLON

  282 comma.opt: ε
  283          | COMMA


