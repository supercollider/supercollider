   19 class: CLASSNAME class.slot.opt class.super.opt OPENCURLY members.opt method.list.opt CLOSECURLY

   20 class.super.opt: ε
   21                | COLON CLASSNAME

   22 class.slot.opt: ε
   23               | OPENSQUARE name CLOSESQUARE

   24 class.extension: ADD CLASSNAME OPENCURLY method.list.opt CLOSECURLY

   25 members.entry.item: accessor variable_declarations.list.item

   26 members.entry.list: members.entry.item
   27                   | members.entry.list COMMA members.entry.item

   28 members.entry: CLASSVAR members.entry.list
   29              | VAR members.entry.list
   30              | CONST members.entry.list

   31 members: members.entry
   32        | members SEMICOLON members.entry

   33 members.opt: ε
   34            | members semicolon.opt

   35 method.name: name
   36            | binary_op.raw

   37 method.base: method.name OPENCURLY argument_declarations.opt block.contents semicolon.opt CLOSECURLY
