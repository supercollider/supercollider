  160                                | HASH name.list comma.opt EQUALSSIGN expr
  161                                | HASH name.list comma.opt OPENPAREN expr.seq CLOSEPAREN

  162 variable_declarations.list: variable_declarations.list.item
  163                           | variable_declarations.list COMMA variable_declarations.list.item

  164 variable_declarations: VAR variable_declarations.list

  165 literal.terminal: symbol
