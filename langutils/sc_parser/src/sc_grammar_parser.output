   76 msgsend: OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN arguments CLOSEPAREN block.opt_list
   77        | OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN CLOSEPAREN block.list
   78        | OPENPAREN binary_op.no_adverb CLOSEPAREN block.list
   79        | name OPENPAREN arguments CLOSEPAREN block.opt_list
   80        | name OPENPAREN CLOSEPAREN block.list
   81        | name block.list
   82        | expr DOT name arguments.maybe_paren block.opt_list
   83        | expr DOT arguments.paren block.opt_list
   84        | expr DOT OPENPAREN CLOSEPAREN block.opt_list
   85        | CLASSNAME OPENSQUARE literal.array.contents CLOSESQUARE
   86        | CLASSNAME block.list
   87        | CLASSNAME OPENPAREN arguments CLOSEPAREN block.opt_list
   88        | CLASSNAME OPENPAREN CLOSEPAREN block.opt_list

