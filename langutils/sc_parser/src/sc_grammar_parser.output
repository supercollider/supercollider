Terminals unused in grammar

    BADTOKEN
    LEXER_ERROR


Grammar

    0 $accept: go $end

    1 go: region semicolon.opt $end
    2   | INTERPRET $end
    3   | file_as_func
    4   | classOrExtList.list $end
    5   | ε

    6 file_as_func: INTERPRET argument_declarations block.contents semicolon.opt $end
    7             | INTERPRET variable_declarations SEMICOLON block.contents semicolon.opt $end
    8             | INTERPRET variable_declarations semicolon.opt $end

    9 region.item: expr
   10            | NONLOCALRETURN expr
   11            | OPENPAREN argument_declarations block.contents semicolon.opt CLOSEPAREN
   12            | OPENPAREN argument_declarations CLOSEPAREN
   13            | OPENPAREN variable_declarations SEMICOLON block.contents semicolon.opt CLOSEPAREN

   14 region: INTERPRET region.item
   15       | INTERPRET error
   16       | region SEMICOLON region.item
   17       | region REGION_SEPARATOR region.item
   18       | region error

   19 classOrExtList.list: classOrExtList.item
   20                    | classOrExtList.list classOrExtList.item

   21 classOrExtList.item: class
   22                    | class.extension

   23 class: CLASSNAME class.slot.opt class.super.opt OPENCURLY members.opt method.list.opt CLOSECURLY

   24 class.super.opt: ε
   25                | COLON CLASSNAME

   26 class.slot.opt: ε
   27               | OPENSQUARE name CLOSESQUARE
   28               | OPENSQUARE CLOSESQUARE

   29 class.extension: ADD CLASSNAME OPENCURLY method.list.opt CLOSECURLY

   30 members.entry.item: accessor variable_declarations.list.item

   31 members.entry.list: members.entry.item
   32                   | members.entry.list COMMA members.entry.item

   33 members.entry: CLASSVAR members.entry.list
   34              | VAR members.entry.list
   35              | CONST members.entry.list

   36 members: members.entry
   37        | members SEMICOLON members.entry

   38 members.opt: ε
   39            | members semicolon.opt

   40 method.name: name
   41            | binary_op.raw

   42 method.base: method.name OPENCURLY argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   43            | method.name OPENCURLY argument_declarations.opt CLOSECURLY
   44            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt block.contents semicolon.opt CLOSECURLY
   45            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt CLOSECURLY
   46            | method.name OPENCURLY error

   47 method: method.base
   48       | MULTIPLY method.base

   49 method.list: method
   50            | method.list method

   51 method.list.opt: ε
   52                | method.list

   53 block.open: OPENCURLY
   54           | BEGINCLOSEDFUNC

   55 block: block.open argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   56      | block.open argument_declarations.opt CLOSECURLY

   57 block.opt_list: ε
   58               | block.list

   59 block.list: block
   60           | generator
   61           | block.list block
   62           | block.list generator

   63 block.contents: block.contents.item
   64               | block.contents SEMICOLON block.contents.item
   65               | block.contents NONLOCALRETURN expr
   66               | block.contents SEMICOLON NONLOCALRETURN expr
   67               | NONLOCALRETURN expr

   68 block.contents.item: expr
   69                    | variable_declarations

   70 adverb: DOT name
   71       | DOT integer
   72       | DOT OPENPAREN expr_or_seq CLOSEPAREN

   73 binary_op.raw: BINOP
   74              | READWRITEVAR
   75              | LESSTHAN
   76              | GREATERTHAN
   77              | MINUS
   78              | MULTIPLY
   79              | ADD
   80              | PIPE

   81 binary_op.no_adverb: binary_op.raw
   82                    | KEYBINOP

   83 binary_op: binary_op.no_adverb adverb
   84          | binary_op.no_adverb

   85 msgsend: OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN arguments CLOSEPAREN block.opt_list
   86        | OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN CLOSEPAREN block.list
   87        | OPENPAREN binary_op.no_adverb CLOSEPAREN block.list
   88        | name OPENPAREN arguments CLOSEPAREN block.opt_list
   89        | name OPENPAREN CLOSEPAREN block.list
   90        | name block.list
   91        | expr DOT name arguments.maybe_paren block.opt_list
   92        | expr DOT arguments.paren block.opt_list
   93        | expr DOT OPENPAREN CLOSEPAREN block.opt_list
   94        | CLASSNAME OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
   95        | CLASSNAME block.list
   96        | CLASSNAME arguments.paren block.opt_list
   97        | CLASSNAME OPENPAREN CLOSEPAREN block.opt_list

   98 expr.dotrange: expr DOT OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE
   99              | expr DOT OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE
  100              | expr DOT OPENSQUARE arguments DOTDOT CLOSESQUARE

  101 expr.dotrange.assign: expr DOT OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr
  102                     | expr DOT OPENSQUARE arguments DOTDOT CLOSESQUARE EQUALSSIGN expr
  103                     | expr DOT OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr

  104 expr.base.range: expr.base OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE
  105                | expr.base OPENSQUARE arguments DOTDOT CLOSESQUARE
  106                | expr.base OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE

  107 expr.base.range.assign: expr.base OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr
  108                       | expr.base OPENSQUARE arguments DOTDOT CLOSESQUARE EQUALSSIGN expr
  109                       | expr.base OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr

  110 range: OPENPAREN expr_or_seq DOTDOT CLOSEPAREN
  111      | OPENPAREN expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  112      | OPENPAREN expr_or_seq COMMA expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  113      | OPENPAREN expr_or_seq COMMA expr_or_seq DOTDOT CLOSEPAREN
  114      | OPENPAREN DOTDOT expr_or_seq CLOSEPAREN

  115 range.generator: OPENPAREN COLON expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  116                | OPENPAREN COLON expr_or_seq COMMA expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  117                | OPENPAREN COLON expr_or_seq COMMA expr_or_seq DOTDOT CLOSEPAREN
  118                | OPENPAREN COLON DOTDOT expr_or_seq CLOSEPAREN
  119                | OPENPAREN COLON expr_or_seq DOTDOT CLOSEPAREN

  120 expr.base: literal
  121          | generator
  122          | name
  123          | CURRYARG
  124          | msgsend
  125          | OPENPAREN expr_or_seq CLOSEPAREN
  126          | OPENPAREN error
  127          | TILDE name
  128          | expr.base OPENSQUARE arguments CLOSESQUARE
  129          | expr.base OPENSQUARE CLOSESQUARE
  130          | expr.base.range
  131          | range
  132          | range.generator

  133 expr: expr.base
  134     | expr.base.range.assign
  135     | expr.dotrange
  136     | expr.dotrange.assign
  137     | expr DOT OPENSQUARE arguments CLOSESQUARE
  138     | expr DOT OPENSQUARE CLOSESQUARE
  139     | expr binary_op expr
  140     | expr DOT name EQUALSSIGN expr
  141     | CLASSNAME
  142     | BACKTICK expr
  143     | name EQUALSSIGN expr
  144     | TILDE name EQUALSSIGN expr
  145     | name OPENPAREN arguments CLOSEPAREN EQUALSSIGN expr
  146     | name.pack EQUALSSIGN expr
  147     | name.pack OPENPAREN expr_or_seq CLOSEPAREN
  148     | expr.base OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
  149     | expr.base OPENSQUARE CLOSESQUARE EQUALSSIGN expr
  150     | expr DOT OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
  151     | expr DOT OPENSQUARE CLOSESQUARE EQUALSSIGN expr

  152 expr_or_seq.base: expr
  153                 | expr_or_seq.base SEMICOLON expr

  154 expr_or_seq: expr_or_seq.base semicolon.opt

  155 generator: OPENCURLY COLON expr_or_seq COMMA generator.qual.list comma.opt CLOSECURLY
  156          | OPENCURLY SEMICOLON expr_or_seq COMMA generator.qual.list comma.opt CLOSECURLY

  157 generator.qual.list: generator.qual
  158                    | generator.qual.list COMMA generator.qual

  159 generator.qual: name LEFTARROW expr_or_seq
  160               | name name LEFTARROW expr_or_seq
  161               | VAR name EQUALSSIGN expr_or_seq
  162               | VAR name OPENPAREN expr_or_seq CLOSEPAREN
  163               | expr_or_seq
  164               | COLON COLON expr_or_seq
  165               | COLON WHILE expr_or_seq

  166 argument_declarations.list: name
  167                           | name EQUALSSIGN expr
  168                           | name OPENPAREN expr_or_seq CLOSEPAREN
  169                           | argument_declarations.list COMMA name
  170                           | argument_declarations.list COMMA name EQUALSSIGN expr
  171                           | argument_declarations.list COMMA name OPENPAREN expr_or_seq CLOSEPAREN

  172 argument_declarations.pipelist: name literal
  173                               | name
  174                               | name EQUALSSIGN literal
  175                               | name OPENPAREN expr_or_seq CLOSEPAREN
  176                               | name EQUALSSIGN OPENPAREN expr_or_seq CLOSEPAREN
  177                               | argument_declarations.pipelist comma.opt name literal
  178                               | argument_declarations.pipelist comma.opt name
  179                               | argument_declarations.pipelist comma.opt name EQUALSSIGN literal
  180                               | argument_declarations.pipelist comma.opt name OPENPAREN expr_or_seq CLOSEPAREN
  181                               | argument_declarations.pipelist comma.opt name EQUALSSIGN OPENPAREN expr_or_seq CLOSEPAREN

  182 argument_declarations: ARG SEMICOLON
  183                      | ARG argument_declarations.list comma.opt SEMICOLON
  184                      | ARG argument_declarations.list ELLIPSIS name SEMICOLON
  185                      | ARG argument_declarations.list ELLIPSIS name COMMA name SEMICOLON
  186                      | ARG ELLIPSIS name SEMICOLON
  187                      | ARG ELLIPSIS name COMMA name SEMICOLON
  188                      | PIPE PIPE
  189                      | PIPE argument_declarations.pipelist comma.opt PIPE
  190                      | PIPE argument_declarations.pipelist ELLIPSIS name PIPE
  191                      | PIPE argument_declarations.pipelist ELLIPSIS name COMMA name PIPE
  192                      | PIPE ELLIPSIS name PIPE
  193                      | PIPE ELLIPSIS name COMMA name PIPE

  194 argument_declarations.opt: ε
  195                          | argument_declarations

  196 arguments.entries: KEYBINOP expr_or_seq
  197                  | MULTIPLY expr_or_seq
  198                  | expr_or_seq

  199 arguments.no_trailing: arguments.entries
  200                      | arguments.no_trailing COMMA arguments.entries

  201 arguments: arguments.no_trailing comma.opt

  202 arguments.paren: OPENPAREN arguments CLOSEPAREN

  203 arguments.maybe_paren: ε
  204                      | OPENPAREN CLOSEPAREN
  205                      | OPENPAREN arguments CLOSEPAREN

  206 variable_declarations.list.item: name
  207                                | name EQUALSSIGN expr
  208                                | name OPENPAREN expr_or_seq CLOSEPAREN
  209                                | name.pack EQUALSSIGN expr
  210                                | name.pack OPENPAREN expr_or_seq CLOSEPAREN

  211 variable_declarations.list: variable_declarations.list.item
  212                           | variable_declarations.list COMMA variable_declarations.list.item

  213 variable_declarations: VAR variable_declarations.list

  214 literal.terminal: symbol
  215                 | string
  216                 | integer
  217                 | float
  218                 | boolean
  219                 | nil
  220                 | ascii
  221                 | block

  222 literal.array.contents: ε
  223                       | expr_or_seq
  224                       | expr_or_seq COLON expr_or_seq
  225                       | KEYBINOP expr_or_seq
  226                       | literal.array.contents COMMA expr_or_seq
  227                       | literal.array.contents COMMA expr_or_seq COLON expr_or_seq
  228                       | literal.array.contents COMMA KEYBINOP expr_or_seq

  229 literal.dictionary.entry: expr COLON expr_or_seq
  230                         | KEYBINOP expr_or_seq

  231 literal.dictionary.entries: ε
  232                           | literal.dictionary.entry
  233                           | literal.dictionary.entries COMMA literal.dictionary.entry

  234 literal.dictionary: OPENPAREN literal.dictionary.entries comma.opt CLOSEPAREN

  235 literal.array: OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
  236              | HASH OPENSQUARE literal.array.contents comma.opt CLOSESQUARE

  237 literal: literal.terminal
  238        | literal.array
  239        | literal.dictionary

  240 name: NAME
  241     | WHILE

  242 name.list: HASH name
  243          | HASH TILDE name
  244          | name.list COMMA name
  245          | name.list COMMA TILDE name

  246 name.pack: name.list
  247          | name.list ELLIPSIS name
  248          | name.list ELLIPSIS TILDE name

  249 ascii: ASCII

  250 nil: NIL

  251 boolean: TRUE
  252        | FALSE

  253 symbol: SYMBOL_QUOTE
  254       | SYMBOL_SLASH

  255 string: STRINGLINE
  256       | string STRINGLINE

  257 integer: INTEGER
  258        | INTEGER_RADIX
  259        | HEXADECIMAL
  260        | MINUS integer

  261 float.raw_unsigned: FLOAT
  262                   | FLOAT_RADIX
  263                   | FLOAT_EXPONENT
  264                   | FLOAT_INF

  265 float.raw: float.raw_unsigned
  266          | MINUS float.raw_unsigned

  267 accidental.unsigned: ACCIDENTAL_STEPS
  268                    | ACCIDENTAL_CENTS

  269 accidental: accidental.unsigned
  270           | MINUS accidental.unsigned

  271 float: float.raw
  272      | accidental
  273      | float.raw PI
  274      | integer PI
  275      | PI
  276      | MINUS PI

  277 accessor: ε
  278         | LESSTHAN
  279         | GREATERTHAN
  280         | READWRITEVAR

  281 semicolon.opt: ε
  282              | SEMICOLON

  283 comma.opt: ε
  284          | COMMA


