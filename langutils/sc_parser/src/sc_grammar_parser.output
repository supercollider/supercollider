  137                      | ARG ELLIPSIS name SEMICOLON
  138                      | ARG ELLIPSIS name COMMA name SEMICOLON
  139                      | PIPE PIPE
  140                      | PIPE argument_declarations.pipelist comma.opt PIPE
  141                      | PIPE argument_declarations.pipelist ELLIPSIS name PIPE
  142                      | PIPE argument_declarations.pipelist ELLIPSIS name COMMA name PIPE
  143                      | PIPE ELLIPSIS name PIPE
  144                      | PIPE ELLIPSIS name COMMA name PIPE

  145 argument_declarations.opt: ε
  146                          | argument_declarations

  147 arguments.entries: KEYBINOP expr.seq
  148                  | MULTIPLY expr.seq
  149                  | expr.seq

  150 arguments.no_trailing: arguments.entries
  151                      | arguments.no_trailing COMMA arguments.entries

  152 arguments: arguments.no_trailing comma.opt

  153 arguments.paren: OPENPAREN arguments CLOSEPAREN

  154 arguments.maybe_paren: ε
  155                      | OPENPAREN CLOSEPAREN
  156                      | arguments.paren

  157 variable_declarations.list.item: name
  158                                | name EQUALSSIGN expr
