  182 literal.dictionary.entries: ε
  183                           | literal.dictionary.entry
  184                           | literal.dictionary.entries COMMA literal.dictionary.entry

  185 literal.dictionary: OPENPAREN literal.dictionary.entries comma.opt CLOSEPAREN

