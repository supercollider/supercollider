Terminals unused in grammar

    BADTOKEN
    LEXER_ERROR


Grammar

    0 $accept: go $end

    1 go: region semicolon.opt $end
    2   | INTERPRET $end
    3   | file_as_func
    4   | classOrExtList.list $end
    5   | ε

    6 file_as_func: INTERPRET argument_declarations block.contents semicolon.opt $end
    7             | INTERPRET variable_declarations SEMICOLON block.contents semicolon.opt $end
    8             | INTERPRET variable_declarations semicolon.opt $end

    9 region.item: expr
   10            | OPENPAREN argument_declarations block.contents semicolon.opt CLOSEPAREN
   11            | OPENPAREN argument_declarations CLOSEPAREN
   12            | OPENPAREN variable_declarations SEMICOLON block.contents semicolon.opt CLOSEPAREN

   13 region: INTERPRET region.item
   14       | INTERPRET error
   15       | region SEMICOLON region.item
   16       | region REGION_SEPARATOR region.item
   17       | region error

   18 classOrExtList.list: classOrExtList.item
   19                    | classOrExtList.list classOrExtList.item

   20 classOrExtList.item: class
   21                    | class.extension

   22 class: CLASSNAME class.slot.opt class.super.opt OPENCURLY members.opt method.list.opt CLOSECURLY

   23 class.super.opt: ε
   24                | COLON CLASSNAME

   25 class.slot.opt: ε
   26               | OPENSQUARE name CLOSESQUARE
   27               | OPENSQUARE CLOSESQUARE

   28 class.extension: ADD CLASSNAME OPENCURLY method.list.opt CLOSECURLY

   29 members.entry.item: accessor variable_declarations.list.item

   30 members.entry.list: members.entry.item
   31                   | members.entry.list COMMA members.entry.item

   32 members.entry: CLASSVAR members.entry.list
   33              | VAR members.entry.list
   34              | CONST members.entry.list

   35 members: members.entry
   36        | members SEMICOLON members.entry

   37 members.opt: ε
   38            | members semicolon.opt

   39 method.name: name
   40            | binary_op.raw

   41 method.base: method.name OPENCURLY argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   42            | method.name OPENCURLY argument_declarations.opt CLOSECURLY
   43            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt block.contents semicolon.opt CLOSECURLY
   44            | method.name OPENCURLY argument_declarations.opt PRIMITIVENAME semicolon.opt CLOSECURLY
   45            | method.name OPENCURLY error

   46 method: method.base
   47       | MULTIPLY method.base

   48 method.list: method
   49            | method.list method

   50 method.list.opt: ε
   51                | method.list

   52 block.open: OPENCURLY
   53           | BEGINCLOSEDFUNC

   54 block: block.open argument_declarations.opt block.contents semicolon.opt CLOSECURLY
   55      | block.open argument_declarations.opt CLOSECURLY

   56 block.opt_list: ε
   57               | block.list

   58 block.list: block
   59           | generator
   60           | block.list block
   61           | block.list generator

   62 block.contents: block.contents.item
   63               | block.contents SEMICOLON block.contents.item
   64               | block.contents NONLOCALRETURN expr
   65               | block.contents SEMICOLON NONLOCALRETURN expr
   66               | NONLOCALRETURN expr

   67 block.contents.item: expr
   68                    | variable_declarations

   69 adverb: DOT name
   70       | DOT integer
   71       | DOT OPENPAREN expr_or_seq CLOSEPAREN

   72 binary_op.raw: BINOP
   73              | READWRITEVAR
   74              | LESSTHAN
   75              | GREATERTHAN
   76              | MINUS
   77              | MULTIPLY
   78              | ADD
   79              | PIPE

   80 binary_op.no_adverb: binary_op.raw
   81                    | KEYBINOP

   82 binary_op: binary_op.no_adverb adverb
   83          | binary_op.no_adverb

   84 msgsend: OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN arguments CLOSEPAREN block.opt_list
   85        | OPENPAREN binary_op.no_adverb CLOSEPAREN OPENPAREN CLOSEPAREN block.list
   86        | OPENPAREN binary_op.no_adverb CLOSEPAREN block.list
   87        | name OPENPAREN arguments CLOSEPAREN block.opt_list
   88        | name OPENPAREN CLOSEPAREN block.list
   89        | name block.list
   90        | expr DOT name arguments.maybe_paren block.opt_list
   91        | expr DOT arguments.paren block.opt_list
   92        | expr DOT OPENPAREN CLOSEPAREN block.opt_list
   93        | CLASSNAME OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
   94        | CLASSNAME block.list
   95        | CLASSNAME arguments.paren block.opt_list
   96        | CLASSNAME OPENPAREN CLOSEPAREN block.opt_list

   97 expr.dotrange: expr DOT OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE
   98              | expr DOT OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE
   99              | expr DOT OPENSQUARE arguments DOTDOT CLOSESQUARE

  100 expr.dotrange.assign: expr DOT OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr
  101                     | expr DOT OPENSQUARE arguments DOTDOT CLOSESQUARE EQUALSSIGN expr
  102                     | expr DOT OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr

  103 expr.base.range: expr.base OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE
  104                | expr.base OPENSQUARE arguments DOTDOT CLOSESQUARE
  105                | expr.base OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE

  106 expr.base.range.assign: expr.base OPENSQUARE arguments DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr
  107                       | expr.base OPENSQUARE arguments DOTDOT CLOSESQUARE EQUALSSIGN expr
  108                       | expr.base OPENSQUARE DOTDOT expr_or_seq CLOSESQUARE EQUALSSIGN expr

  109 range: OPENPAREN expr_or_seq DOTDOT CLOSEPAREN
  110      | OPENPAREN expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  111      | OPENPAREN expr_or_seq COMMA expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  112      | OPENPAREN expr_or_seq COMMA expr_or_seq DOTDOT CLOSEPAREN
  113      | OPENPAREN DOTDOT expr_or_seq CLOSEPAREN

  114 range.generator: OPENPAREN COLON expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  115                | OPENPAREN COLON expr_or_seq COMMA expr_or_seq DOTDOT expr_or_seq CLOSEPAREN
  116                | OPENPAREN COLON expr_or_seq COMMA expr_or_seq DOTDOT CLOSEPAREN
  117                | OPENPAREN COLON DOTDOT expr_or_seq CLOSEPAREN
  118                | OPENPAREN COLON expr_or_seq DOTDOT CLOSEPAREN

  119 expr.base: literal
  120          | generator
  121          | name
  122          | CURRYARG
  123          | msgsend
  124          | OPENPAREN expr_or_seq CLOSEPAREN
  125          | TILDE name
  126          | expr.base OPENSQUARE arguments CLOSESQUARE
  127          | expr.base OPENSQUARE CLOSESQUARE
  128          | expr.base.range
  129          | range
  130          | range.generator

  131 expr: expr.base
  132     | expr.base.range.assign
  133     | expr.dotrange
  134     | expr.dotrange.assign
  135     | expr DOT OPENSQUARE arguments CLOSESQUARE
  136     | expr DOT OPENSQUARE CLOSESQUARE
  137     | expr binary_op expr
  138     | expr DOT name EQUALSSIGN expr
  139     | CLASSNAME
  140     | BACKTICK expr
  141     | name EQUALSSIGN expr
  142     | TILDE name EQUALSSIGN expr
  143     | name OPENPAREN arguments CLOSEPAREN EQUALSSIGN expr
  144     | name.pack EQUALSSIGN expr
  145     | name.pack OPENPAREN expr_or_seq CLOSEPAREN
  146     | expr.base OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
  147     | expr.base OPENSQUARE CLOSESQUARE EQUALSSIGN expr
  148     | expr DOT OPENSQUARE arguments CLOSESQUARE EQUALSSIGN expr
  149     | expr DOT OPENSQUARE CLOSESQUARE EQUALSSIGN expr

  150 expr_or_seq.base: expr
  151                 | expr_or_seq.base SEMICOLON expr

  152 expr_or_seq: expr_or_seq.base semicolon.opt

  153 generator: OPENCURLY COLON expr_or_seq COMMA generator.qual.list comma.opt CLOSECURLY
  154          | OPENCURLY SEMICOLON expr_or_seq COMMA generator.qual.list comma.opt CLOSECURLY

  155 generator.qual.list: generator.qual
  156                    | generator.qual.list COMMA generator.qual

  157 generator.qual: name LEFTARROW expr_or_seq
  158               | name name LEFTARROW expr_or_seq
  159               | VAR name EQUALSSIGN expr_or_seq
  160               | VAR name OPENPAREN expr_or_seq CLOSEPAREN
  161               | expr_or_seq
  162               | COLON COLON expr_or_seq
  163               | COLON WHILE expr_or_seq

  164 argument_declarations.list: name
  165                           | name EQUALSSIGN expr
  166                           | name OPENPAREN expr_or_seq CLOSEPAREN
  167                           | argument_declarations.list COMMA name
  168                           | argument_declarations.list COMMA name EQUALSSIGN expr
  169                           | argument_declarations.list COMMA name OPENPAREN expr_or_seq CLOSEPAREN

  170 argument_declarations.pipelist: name literal
  171                               | name
  172                               | name EQUALSSIGN literal
  173                               | name OPENPAREN expr_or_seq CLOSEPAREN
  174                               | name EQUALSSIGN OPENPAREN expr_or_seq CLOSEPAREN
  175                               | argument_declarations.pipelist comma.opt name literal
  176                               | argument_declarations.pipelist comma.opt name
  177                               | argument_declarations.pipelist comma.opt name EQUALSSIGN literal
  178                               | argument_declarations.pipelist comma.opt name OPENPAREN expr_or_seq CLOSEPAREN
  179                               | argument_declarations.pipelist comma.opt name EQUALSSIGN OPENPAREN expr_or_seq CLOSEPAREN

  180 argument_declarations: ARG SEMICOLON
  181                      | ARG argument_declarations.list comma.opt SEMICOLON
  182                      | ARG argument_declarations.list ELLIPSIS name SEMICOLON
  183                      | ARG argument_declarations.list ELLIPSIS name COMMA name SEMICOLON
  184                      | ARG ELLIPSIS name SEMICOLON
  185                      | ARG ELLIPSIS name COMMA name SEMICOLON
  186                      | PIPE PIPE
  187                      | PIPE argument_declarations.pipelist comma.opt PIPE
  188                      | PIPE argument_declarations.pipelist ELLIPSIS name PIPE
  189                      | PIPE argument_declarations.pipelist ELLIPSIS name COMMA name PIPE
  190                      | PIPE ELLIPSIS name PIPE
  191                      | PIPE ELLIPSIS name COMMA name PIPE

  192 argument_declarations.opt: ε
  193                          | argument_declarations

  194 arguments.entries: KEYBINOP expr_or_seq
  195                  | MULTIPLY expr_or_seq
  196                  | expr_or_seq

  197 arguments.no_trailing: arguments.entries
  198                      | arguments.no_trailing COMMA arguments.entries

  199 arguments: arguments.no_trailing comma.opt

  200 arguments.paren: OPENPAREN arguments CLOSEPAREN

  201 arguments.maybe_paren: ε
  202                      | OPENPAREN CLOSEPAREN
  203                      | OPENPAREN arguments CLOSEPAREN

  204 variable_declarations.list.item: name
  205                                | name EQUALSSIGN expr
  206                                | name OPENPAREN expr_or_seq CLOSEPAREN
  207                                | name.pack EQUALSSIGN expr
  208                                | name.pack OPENPAREN expr_or_seq CLOSEPAREN

  209 variable_declarations.list: variable_declarations.list.item
  210                           | variable_declarations.list COMMA variable_declarations.list.item

  211 variable_declarations: VAR variable_declarations.list

  212 literal.terminal: symbol
  213                 | string
  214                 | integer
  215                 | float
  216                 | boolean
  217                 | nil
  218                 | ascii
  219                 | block

  220 literal.array.contents: ε
  221                       | expr_or_seq
  222                       | expr_or_seq COLON expr_or_seq
  223                       | KEYBINOP expr_or_seq
  224                       | literal.array.contents COMMA expr_or_seq
  225                       | literal.array.contents COMMA expr_or_seq COLON expr_or_seq
  226                       | literal.array.contents COMMA KEYBINOP expr_or_seq

  227 literal.dictionary.entry: expr COLON expr_or_seq
  228                         | KEYBINOP expr_or_seq

  229 literal.dictionary.entries: ε
  230                           | literal.dictionary.entry
  231                           | literal.dictionary.entries COMMA literal.dictionary.entry

  232 literal.dictionary: OPENPAREN literal.dictionary.entries comma.opt CLOSEPAREN

  233 literal.array: OPENSQUARE literal.array.contents comma.opt CLOSESQUARE
  234              | HASH OPENSQUARE literal.array.contents comma.opt CLOSESQUARE

  235 literal: literal.terminal
  236        | literal.array
  237        | literal.dictionary

  238 name: NAME
  239     | WHILE

  240 name.list: HASH name
  241          | HASH TILDE name
  242          | name.list COMMA name
  243          | name.list COMMA TILDE name

  244 name.pack: name.list
  245          | name.list ELLIPSIS name
  246          | name.list ELLIPSIS TILDE name

  247 ascii: ASCII

  248 nil: NIL

  249 boolean: TRUE
  250        | FALSE

  251 symbol: SYMBOL_QUOTE
  252       | SYMBOL_SLASH

  253 string: STRINGLINE
  254       | string STRINGLINE

  255 integer: INTEGER
  256        | INTEGER_RADIX
  257        | HEXADECIMAL
  258        | MINUS integer

  259 float.raw_unsigned: FLOAT
  260                   | FLOAT_RADIX
  261                   | FLOAT_EXPONENT
  262                   | FLOAT_INF

  263 float.raw: float.raw_unsigned
  264          | MINUS float.raw_unsigned

  265 accidental.unsigned: ACCIDENTAL_STEPS
  266                    | ACCIDENTAL_CENTS

  267 accidental: accidental.unsigned
  268           | MINUS accidental.unsigned

  269 float: float.raw
  270      | accidental
  271      | float.raw PI
  272      | integer PI
  273      | PI
  274      | MINUS PI

  275 accessor: ε
  276         | LESSTHAN
  277         | GREATERTHAN
  278         | READWRITEVAR

  279 semicolon.opt: ε
  280              | SEMICOLON

  281 comma.opt: ε
  282          | COMMA


