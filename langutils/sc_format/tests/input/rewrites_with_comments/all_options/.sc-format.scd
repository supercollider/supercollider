// Every option on, as styles/all.sc-format.scd: the layout of code the rewrites changed, with comments in it.
(
	final_newline: \one,
	trailing_whitespace: \remove,
	max_blank_lines: 2,
	unicode_spaces: \ascii,
	indent: \tab,
	indent_method_chains: \on,
	indent_regions: \on,
	region_brackets: \own_lines,
	space: (
		around_binary_operators: \one,
		around_keyword_operators: \one,
		around_assignment: \one,
		after_comma: \one,
		before_comma: \none,
		before_semicolon: \none,
		inside_braces: \one,
		in_empty_braces: \one,
		before_parameters: \one,
		after_parameters: \one,
		inside_parens: \none,
		inside_brackets: \none,
		inside_pipes: \none,
		around_parameter_equals: \one,
		after_key: \one,
		around_dot: \none,
		before_control_paren: \one,
		before_closure: \one,
	),
	kr: (
		braces: \on,
		parens: \on,
		brackets: \on,
	),
	parameters: (
		on_brace_line: \on,
		pipes: \on,
		commas: \on,
		default_equals: \on,
	),
	multiline: (
		arrays: \one_per_line,
		arguments: \one_per_line,
		control_pairs: \one_per_line,
	),
	final_semicolon: \remove,
	trailing_closures: \control,
	control_prefix: \on,
	region_semicolons: \insert,
	trailing_comma_lists: \expand,
	align_columns: \on,
)
