// Rules 3 to 6, and 9. The guide's correct examples don't change, and its incorrect ones become them.
(
	inherit: true,
	space: (
		around_binary_operators: \one,
		around_keyword_operators: \one,
		after_comma: \one,
		before_comma: \none,
		before_semicolon: \none,
		inside_braces: \one,
		before_parameters: \one,
		inside_parens: \none,
		inside_brackets: \none,
		inside_pipes: \none,
		around_dot: \none,
	),
)
