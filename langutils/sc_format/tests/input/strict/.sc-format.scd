// The style guide as strictly as sc_format can follow it so far: tabs, method chains indented, and one blank line at
// most. The inside of a region stays at the top level.
(
	final_newline: \one,
	trailing_whitespace: \remove,
	max_blank_lines: 1,
	unicode_spaces: \ascii,
	indent: \tab,
	indent_method_chains: \on,
	indent_regions: \off,
)
