// The values all.sc-format.scd doesn't use.
(
	max_blank_lines: 0,
	indent: 4,
	indent_method_chains: \off,
	indent_regions: \off,
	region_brackets: \own_lines,
	space: (
		inside_braces: \none,
		in_empty_braces: \none,
		before_parameters: \none,
		after_parameters: \none,
		around_parameter_equals: \none,
		after_key: \none,
		before_control_paren: \none,
		before_closure: \none,
	),
	parameters: (
		pipes: \one_line,
	),
	trailing_closures: \all,
)
