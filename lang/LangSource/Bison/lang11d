					{ $$ = allocNode<PyrArgListNode>(@$, $2, nullptr, nullptr); }
				| '|' slotdeflist0 ELLIPSIS name '|'
					{ $$ = allocNode<PyrArgListNode>(@$, $2, $4, nullptr); }
				| '|' slotdeflist0 ELLIPSIS name ',' name '|'
				    { $$ = allocNode<PyrArgListNode>(@$, $2, $4, $6); };


constdeflist	: constdef
				| constdeflist optcomma constdef
					{ $$ = linkNextNode($1, $3); } ;

constdef		: rspec name '=' slotliteral
					{ $$ = allocNode<PyrVarDefNode>(@$, $2, $4, $1); };

slotdeflist0 	: %empty { $$ = nullptr; }
				| slotdeflist;

slotdeflist		: slotdef
				| slotdeflist optcomma slotdef
					{ $$ = linkNextNode($1, $3); };

slotdef			: name
					{ $$ = allocNode<PyrVarDefNode>(@$, $1, nullptr, ReadWriteAccessor::Private); }
				| name optequal slotliteral
					{ $$ = allocNode<PyrVarDefNode>(@$, $1, $3, ReadWriteAccessor::Private); }
				| name optequal '(' exprseq ')'
					{
						PyrParseNode* node = $4;
						node->mParens = 1;
						$$ = allocNode<PyrVarDefNode>(@$, $1, node, ReadWriteAccessor::Private);
					};

vardeflist0 	: %empty  { $$ = nullptr; }
				| vardeflist;

vardeflist      : vardef
				| vardeflist ',' vardef
					{ $$ = linkNextNode($1, $3); };

vardef          : name
					{ $$ = allocNode<PyrVarDefNode>(@$, $1, nullptr, ReadWriteAccessor::Private); }
				| name '=' expr
					{ $$ = allocNode<PyrVarDefNode>(@$, $1, $3, ReadWriteAccessor::Private); }
				| name '(' exprseq ')'
					{
						PyrParseNode* node = $3;
						node->mParens = 1;
						$$ = allocNode<PyrVarDefNode>(@$, $1, node, ReadWriteAccessor::Private);
					};

dictslotdef		: exprseq ':' exprseq
					{ $$ = linkNextNode($1, $3); }
				| KEYBINOP exprseq
					{ $$ = linkNextNode($1->changeLiteralType(pn_PushLitNode), $2); }
				;

dictslotlist1	: dictslotdef
				| dictslotlist1 ',' dictslotdef
					{ $$ = linkNextNode($1, $3); } ;

dictslotlist	: %empty { $$ = nullptr; }
				| dictslotlist1 optcomma ;

rwslotdeflist	: rwslotdef
				| rwslotdeflist ',' rwslotdef
					{ $$ = linkNextNode($1, $3); };

rwslotdef		: rwspec name
					{ $$ = allocNode<PyrVarDefNode>(@$, $2, nullptr, $1); }
				| rwspec name '=' slotliteral
					{ $$ = allocNode<PyrVarDefNode>(@$, $2, $4, $1); };

dictlit2		: '(' litdictslotlist ')'
					{ $$ = allocNode<PyrLitDictNode>(@$, $2); };

litdictslotdef	: listliteral ':' listliteral
					{ $$ = linkNextNode($1, $3); }
				| KEYBINOP listliteral
					{ $$ = linkNextNode($1->changeLiteralType(pn_PushLitNode), $2); };

litdictslotlist1: litdictslotdef
				| litdictslotlist1 ',' litdictslotdef
					{ $$ = linkNextNode($1, $3); };

litdictslotlist	: %empty { $$ = nullptr; }
				| litdictslotlist1 optcomma;



listlit			: '#' '[' literallistc ']'
					{ $$ = allocNode<PyrLitListNode>(@$, nullptr, $3); }
				| '#' CLASSNAME  '[' literallistc ']'
						{ $$ = allocNode<PyrLitListNode>(@$, $2, $4); };

listlit2		: '[' literallistc ']'
					{ $$ = allocNode<PyrLitListNode>(@$, nullptr, $2); }
				| CLASSNAME  '[' literallistc ']'
					{ $$ = allocNode<PyrLitListNode>(@$, $1, $3); };

literallistc	: %empty { $$ = nullptr; }
				| literallist1 optcomma;

literallist1	: listliteral
				| literallist1 ',' listliteral
					{ $$ = linkNextNode($1, $3); };

rwspec			:  %empty { $$ = ReadWriteAccessor::Private; }
				| '<' { $$ = ReadWriteAccessor::Read; }
				| READWRITEVAR { $$ = ReadWriteAccessor::ReadWrite; }
				| '>' { $$ = ReadWriteAccessor::Write; };

rspec			: %empty { $$ = ReadWriteAccessor::Private; } 
				| '<' { $$ = ReadWriteAccessor::Read; };

integer			: INTEGER 
				| '-' INTEGER %prec UMINUS 
					{
						const auto v = $2->mSlot.getInt();
						$2->mSlot = PyrSlot::make(-v);
						$$ = $2;
					};

floatr			: SC_FLOAT 
				| '-' SC_FLOAT %prec UMINUS 
					{
						const double v = $2->mSlot.getDouble();
						$2->mSlot = PyrSlot::make(-v);
						$$ = $2;
					};

accidental 		: ACCIDENTAL 
				| '-' ACCIDENTAL %prec UMINUS 
					{
						const double in = $2->mSlot.getDouble();
						const double intval = floor(in + 0.5);
						const double fracval = in - intval;
						$2->mSlot = PyrSlot::make(-intval + fracval);
						$$ = $2;
					};


floatp			: floatr
				| accidental
				| floatr PIE 
					{
						$1->mSlot = PyrSlot::make($1->mSlot.getDouble() * pi);
						$1->mLocation = @$;
						$$ = $1;
					}
				| integer PIE 
					{
						$1->mSlot = PyrSlot::make($1->mSlot.getInt() * pi);
						$1->mLocation = @$;
						$$ = $1;
					}
				| PIE 
				| '-' PIE 
					{
						$2->mSlot = PyrSlot::make(-pi);
						$2->mLocation = @$;
						$$ = $2;
					};

name 			: NAME | WHILE;
binop 			: BINOP | READWRITEVAR | '<' | '>' | '-' | '*' | '+' | '|';
binop2  		: binop | KEYBINOP;
curryArg 		: CURRYARG { $$ = allocNode<PyrCurryArgNode>(@$); }
