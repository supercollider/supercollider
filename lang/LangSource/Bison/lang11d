/*

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Some notes about this file.
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Bison is a LALR bottom-up parser, it is quite old technology and can be hard to use.
LALR is quite difficult to write compared to more modern approaches, but it will produce reduce-shift conflicts if you make a mistake. 
There should be *no* warnings when generating the final parser.

Bottom-up parsing means that the parts of the rule are parsed before the rule itself. All the child nodes are produced *before* the parent. 
This is in stark contrast to other types of parsing, like recursive descent.

This grammar was made in the early 2000s and is showing its age. 
For example, there is a lot of duplication here, particularly regarding the 'msgsend' rule.
This has grown naturally as the language has evolved and could use a refactor, however, changing this requires some form of fuzz testing to ensure compatibility is maintained.
While taking previously invalid syntax and making it valid is generally okay, refactoring existing syntax must be thoroughly tested.

If you are looking at documentation on Bison you will often see it accompanied with Flex, that part is not relevant to understanding this file — although it can be useful.


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Some notes relationship between the lexer and the parser.
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Bison uses global variables everywhere, again, this is because of its age.
We do not support having multiple instances of the parser at once (this is a feature in modern Bison), therefore no multithreading.

The lexer's job is to define a function called yylex.

It produces an int, which is an enum (weakly typed) of the type yytokentype, which can be found in the generated header.
yytokentype, being backed by an integer, can contain all utf8 characters, along with all the special %tokens declared below.

Additionally, yylex writes to several globals used to communicate with the parser.

yylval:

This is a union of type YYSTYPE and contains any produced data.
For example, if tokenizing a double, the lexer could turn the text into a double and write the result there.
YYSTYPE is defined below with the %union statement.

yylloc:

This is the location in the source file of the token. 


It is recommended to read a basic introduction to bison before proceeding, but for ease of understanding:

yyval is accessed in each rule by using '$N' and $$, where 'N' refers to the index of the child rule, and '$$' is the produced value.
Note, '$$' is the field of the union, not the union itself, Bison will automatically deduce which field you should be writing to by looking at the %type statement for that rule.

yyloc is accessed in each by using @$ and @N. Most of the time, this isn't necessary as bison will automatically figure out the correct location info for you.

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Some notes on memory
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

All PyrParseNodes are created using an arena allocator. 
We do not use bison's destructor feature.
You don't have to worry about memory here in this file, but when using the parser there is additional setup and tear-down required.

*/

// This is added to the header.
%code requires { 
#include "BisonHeaderInclude.hpp"
}

// This union will become YYSTYPE. 
// It is what each rule and token produces. 
// Which field is active is determined by the %type <field> statement or %token <field>. 
// The lexer can write to this through yylval, and the parser (this file) can access this by reading from $N and writing to $$.

%union { 
	struct PyrParseNode* node;  // Base class.
	struct PyrSlotNode* slotNode; // For some literal value
	struct PyrVarListNode* varListNode;
	struct PyrVarDefNode* varDefNode;
	struct PyrMethodNode* methodNode;
	struct PyrArgListNode* argListNode;
	struct PyrBlockNode* blockNode;
	struct PyrMultiAssignVarListNode* multiAssignListNode;
	struct PyrRootNode* root;
	ReadWriteAccessor rwAccessor;
	EmptyYYVal empty;
}

// Enable yyloc and the use of @N to access the source code location struct.
%locations
%define api.location.type {sc::lex::SourceCodeRange}

%token <empty> OPENCURLY CLOSECURLY OPENSQUARE CLOSESQUARE OPENPAREN CLOSEPAREN 
%token <empty> SEMICOLON NONLOCALRETURN COMMA HASH TILDE
%token <slotNode> NAME INTEGER SC_FLOAT ACCIDENTAL SYMBOL STRING ASCII PRIMITIVENAME CLASSNAME CURRYARG 
%token <empty> VAR ARG CLASSVAR SC_CONST
%token <slotNode> NILOBJ TRUEOBJ FALSEOBJ PIE
%token <empty> ELLIPSIS DOTDOT BEGINCLOSEDFUNC
%token <empty> BADTOKEN INTERPRET
%token <slotNode> LEFTARROW WHILE

%left <empty> COLON
%right <empty> EQUALSSIGN
%left <slotNode> BINOP KEYBINOP MINUS LESSTHAN GREATERTHAN MULTIPLY ADD PIPE READWRITEVAR
%left <empty> DOT
%right <slotNode> BACKTICK
%right <empty> UMINUS


%type <rwAccessor> rspec rwspec 

%type <slotNode> floatp floatr integer accidental name binop binop2 optName optSuperName optPrim nameList

%type <varListNode> classvardecls classvardecl funcvardecls funcvardecl funcvardecls1

%type <varDefNode> rwslotdef rwslotdeflist constdeflist constdef vardef vardeflist vardeflist0 slotdef slotdeflist slotdeflist0

%type <methodNode> methoddef methods

%type <argListNode> argdecls argdecls1

%type <multiAssignListNode> mavars

%type <root> root

%type <node> listlit2 literallistc listlit classes classextensions classextension 
%type <node> classdef generator qual nextqual expr expr1 exprn exprseq arrayelems arrayelems1 arglist1 arglistv1 keyarglist1 
%type <blockNode> cmdlinecode
%type <node> keyarg optkeyarglist valrangex1 valrangeassign valrangexd literallist1 funcbody funretval pushliteral
%type <node> blockliteral pushname msgsend adverb dictslotlist retval blocklist1 blocklist valrange2 valrange3
%type <node> slotliteral listliteral block methbody dictslotdef dictslotlist1 blocklistitem curryArg

%start root

%{

#include <stdlib.h>
#include <string.h>
#include "PyrLexer.h"
#include "PyrParseNode.h"
#include "SC_Constants.h"
#include "PredefinedSymbols.h"
#include "SimpleStack.h"


void yyerror(const char* s) { bison_cxt->logErrorInCurFile(yylloc, s); }

inline bool checkArraySubrangeSyntax(PyrParseNode* args, const size_t argLen) {
	if(argLen <= 2) 
		return true;
	const auto first = args->mNext->mNext;
	auto last = first;
	while(true) {
		auto next = last->mNext;
		if (next) {
			last = next;
		} else 
			break;
	}
	const auto range = sc::lex::SourceCodeRange::range(first->location, last->location);
	bison_cxt->postErrorInCurrentFile(range, "Invalid subrange", "expected 2 or less arguments, delete these.");
	return false;
}

%}

%define parse.error verbose

%%

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Begin parser rules
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


root	: classes
			{ 
				$$ = bison_cxt->allocParseNode<PyrRootNode>(@$, $1);
				bison_cxt->assignRoot(*$$);
			}
		| classextensions
			{ 
				$$ = bison_cxt->allocParseNode<PyrRootNode>(@$, $1);
				bison_cxt->assignRoot(*$$);
			}
		| INTERPRET cmdlinecode
			{ 
				$$ = bison_cxt->allocParseNode<PyrRootNode>(@$, $2);
				bison_cxt->assignRoot(*$$);
			};

classes : %empty { $$ = nullptr; }
		| classes classdef 
			{ $$ = linkNodes($1, $2); };

classextensions : classextension
				| classextensions classextension
					{ $$ = linkNodes($1, $2); };

classdef	 : CLASSNAME optSuperName OPENCURLY classvardecls methods CLOSECURLY
				{ $$ = bison_cxt->allocParseNode<PyrClassNode>(@$, $1, $2, nullptr, $4, $5); }
			| CLASSNAME OPENSQUARE optName CLOSESQUARE optSuperName OPENCURLY classvardecls methods CLOSECURLY
				{ $$ = bison_cxt->allocParseNode<PyrClassNode>(@$, $1, $5, $3, $7, $8); };

classextension : ADD CLASSNAME OPENCURLY methods CLOSECURLY
					{ $$ = bison_cxt->allocParseNode<PyrClassExtNode>(@$, $2, $4); };

optName		: %empty { $$ = nullptr; } | name;

// Note the inclusion of the colon here.
optSuperName	: %empty { $$ = nullptr; } | COLON CLASSNAME { $$ = $2; };

classvardecls	: %empty { $$ = nullptr; }
				| classvardecls classvardecl
					{ $$ = linkNodes($1, $2); };

classvardecl	: CLASSVAR rwslotdeflist SEMICOLON
					{ $$ = bison_cxt->allocParseNode<PyrVarListNode>(@$, $2, varClass); }
				| VAR rwslotdeflist SEMICOLON
					{ $$ = bison_cxt->allocParseNode<PyrVarListNode>(@$, $2, varInst); }
				| SC_CONST constdeflist SEMICOLON
					{ $$ = bison_cxt->allocParseNode<PyrVarListNode>(@$, $2, varConst); };

methods		: %empty { $$ = nullptr; }
				| methods methoddef
					{ $$ = linkNodes($1, $2); };

methoddef	: name OPENCURLY argdecls funcvardecls optPrim methbody CLOSECURLY
				{ $$ = bison_cxt->allocParseNode<PyrMethodNode>(@$, $1, $5, $3, $4, $6, false); }
			| MULTIPLY name OPENCURLY argdecls funcvardecls optPrim methbody CLOSECURLY
				{ $$ = bison_cxt->allocParseNode<PyrMethodNode>(@$, $2, $6, $4, $5, $7, true); }
			| binop OPENCURLY argdecls funcvardecls optPrim methbody CLOSECURLY
				{ $$ = bison_cxt->allocParseNode<PyrMethodNode>(@$, $1, $5, $3, $4, $6, false); }
			| MULTIPLY binop OPENCURLY argdecls funcvardecls optPrim methbody CLOSECURLY
				{ $$ = bison_cxt->allocParseNode<PyrMethodNode>(@$, $2, $6, $4, $5, $7, true); };

optsemi		: %empty | SEMICOLON;

optcomma	: %empty | COMMA;

optequal	: %empty | EQUALSSIGN;

funcbody	: funretval
			| exprseq funretval
				{ $$ = bison_cxt->allocParseNode<PyrDropNode>(@$, $1, $2); };

cmdlinecode	: OPENPAREN argdecls1 funcvardecls1 funcbody CLOSEPAREN
				{ $$ = bison_cxt->allocParseNode<PyrBlockNode>(@$, $2, $3, $4, false); }
			| OPENPAREN argdecls1 funcbody CLOSEPAREN
				{ $$ = bison_cxt->allocParseNode<PyrBlockNode>(@$, $2, nullptr, $3, false); }
			| OPENPAREN funcvardecls1 funcbody CLOSEPAREN
				{ $$ = bison_cxt->allocParseNode<PyrBlockNode>(@$, nullptr, $2, $3, false); }
			| argdecls1 funcvardecls1 funcbody
				{ $$ = bison_cxt->allocParseNode<PyrBlockNode>(@$, $1, $2, $3, false); }
			| argdecls1 funcbody
				{ $$ = bison_cxt->allocParseNode<PyrBlockNode>(@$, $1, nullptr, $2, false); }
			| funcvardecls1 funcbody
				{ $$ = bison_cxt->allocParseNode<PyrBlockNode>(@$, nullptr, $1, $2, false); }
			| funcbody
				{ $$ = bison_cxt->allocParseNode<PyrBlockNode>(@$, nullptr, nullptr, $1, false); };

methbody	: retval
			| exprseq retval
				{ $$ = bison_cxt->allocParseNode<PyrDropNode>(@$, $1, $2); };

optPrim	: %empty  { $$ = nullptr; }
		| PRIMITIVENAME optsemi { $$ = $1; };

retval	: %empty { $$ = bison_cxt->allocParseNode<PyrReturnNode>(@$, nullptr); }
		| NONLOCALRETURN expr optsemi
			{ $$ = bison_cxt->allocParseNode<PyrReturnNode>(@$, $2); };

funretval	: %empty
				{ $$ = bison_cxt->allocParseNode<PyrBlockReturnNode>(@$, nullptr); }
			| NONLOCALRETURN expr optsemi
				{ $$ = bison_cxt->allocParseNode<PyrReturnNode>(@$, $2); };

blocklist1	: blocklistitem
			| blocklist1 blocklistitem
				{ $$ = linkNodes($1, $2); };

blocklistitem : blockliteral | generator;

blocklist	: %empty { $$ = nullptr; } | blocklist1;

msgsend : name blocklist1
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $1, $2, nullptr); }
			
		| OPENPAREN binop2 CLOSEPAREN blocklist1
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $2, $4, nullptr); }

		| name OPENPAREN CLOSEPAREN blocklist1
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $1, $4, nullptr); }

		| name OPENPAREN arglist1 optkeyarglist CLOSEPAREN blocklist
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $1, linkNodes($3, $6), $4); }

		| OPENPAREN binop2 CLOSEPAREN OPENPAREN CLOSEPAREN blocklist1
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $2, $6, nullptr); }

		| OPENPAREN binop2 CLOSEPAREN OPENPAREN arglist1 optkeyarglist CLOSEPAREN blocklist
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $2, linkNodes($5, $8), $6); }

		| name OPENPAREN arglistv1 optkeyarglist CLOSEPAREN
			{
				PyrSlot selector;
				// Is the keyword 'super' in 'msg(super, *[])'.
				if (isSuperObjNode($3)) {
					auto* slot_node = nodeCast<PyrSlotNode>($3);
					slot_node->mSlot = PyrSlot::make(s_this);
					selector = PyrSlot::make(s_superPerformList);
				} else {
					selector = PyrSlot::make(s_performList);
				}
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, selector);
				auto* args = linkAfterHead($3, $1->changeLiteralType<PyrParseNodeType::PushLitNode>());
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, args, $4);
			}
		| OPENPAREN binop2 CLOSEPAREN OPENPAREN arglistv1 optkeyarglist CLOSEPAREN
			{
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_performList));
				auto* args = linkAfterHead($5, $2->changeLiteralType<PyrParseNodeType::PushLitNode>());
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, args, $6);
			}
		| CLASSNAME OPENSQUARE arrayelems CLOSESQUARE
			{ $$ = bison_cxt->allocParseNode<PyrDynListNode>(@$, $1, $3); }

		| CLASSNAME blocklist1
			{
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new));
				auto* args = linkNodes($1->changeLiteralType<PyrParseNodeType::PushNameNode>(), $2);
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
			}
		| CLASSNAME OPENPAREN CLOSEPAREN blocklist
			{
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new));
				auto* args = linkNodes($1->changeLiteralType<PyrParseNodeType::PushNameNode>(), $4);
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, args, nullptr);
			}
		| CLASSNAME OPENPAREN keyarglist1 optcomma CLOSEPAREN blocklist
			{
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new));
				auto* args = linkNodes($1->changeLiteralType<PyrParseNodeType::PushNameNode>(), $6);
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, args, $3);
			}
		| CLASSNAME OPENPAREN arglist1 optkeyarglist CLOSEPAREN blocklist
			{
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new));
				auto* args = linkNodes(
					$1->changeLiteralType<PyrParseNodeType::PushNameNode>(), 
					$3,
					$6);
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, args, $4);
			}
		| CLASSNAME OPENPAREN arglistv1 optkeyarglist CLOSEPAREN
			{
				PyrSlot selector;
				if (isSuperObjNode($1)) {
					// Ehh? this is not possible. CLASSNAME cannot be 'super'.
					$1->mSlot = PyrSlot::make(s_this);
					selector = PyrSlot::make(s_superPerformList);
				} else {
					selector = PyrSlot::make(s_performList);
				}

				auto* new_selector_push_lit = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_new), PyrParseNodeType::PushLitNode);
				auto* args = linkNodes(
					$1->changeLiteralType<PyrParseNodeType::PushNameNode>(),
					new_selector_push_lit,
					$3
				);
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, selector);
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, args, $4);
			}
		| expr DOT OPENPAREN CLOSEPAREN blocklist
			{
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_value));
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, $5), nullptr);
			}
		| expr DOT OPENPAREN keyarglist1 optcomma CLOSEPAREN blocklist
			{
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_value));
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, $7), $4);
			}
		| expr DOT name OPENPAREN keyarglist1 optcomma CLOSEPAREN blocklist
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $3, linkNodes($1, $8), $5); }
		| expr DOT OPENPAREN arglist1 optkeyarglist CLOSEPAREN blocklist
			{
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_value));
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($1, $4, $7), $5);
			}
		| expr DOT OPENPAREN arglistv1 optkeyarglist CLOSEPAREN
			{
				PyrSlot selectorSlot;
				if (isSuperObjNode($1)) {
					nodeCast<PyrSlotNode>($1)->mSlot = PyrSlot::make(s_this);
					selectorSlot = PyrSlot::make(s_superPerformList);
				} else {
					selectorSlot = PyrSlot::make(s_performList);
				}
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, selectorSlot);
				auto* args = linkNodes(
					$1, 
					bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(s_value), PyrParseNodeType::PushLitNode),
					$4
				);
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, args, $5);
			}
		| expr DOT name OPENPAREN CLOSEPAREN blocklist
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $3, linkNodes($1, $6), nullptr); }
		| expr DOT name OPENPAREN arglist1 optkeyarglist CLOSEPAREN blocklist
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $3, linkNodes($1, $5, $8), $6); }
		| expr DOT name OPENPAREN arglistv1 optkeyarglist CLOSEPAREN
			{
				PyrSlot slot;
				if (isSuperObjNode($1)) {
					nodeCast<PyrSlotNode>($1)->mSlot = PyrSlot::make(s_this);
					slot = PyrSlot::make(s_superPerformList);
				} else {
					slot = PyrSlot::make(s_performList);
				}
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, slot);
				auto* args = linkNodes($1, $3->changeLiteralType<PyrParseNodeType::PushLitNode>(), $5);
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, args, $6);
			}
		| expr DOT name blocklist
			{ $$ = bison_cxt->allocParseNode<PyrCallNode>(@$, $3, linkNodes($1, $4), nullptr); } ;



// This section is for list comprehension/generators. 
// It uses the generatorStack and I do not know how it works. 
// In future, it would be good to create some documentation for this.
// For now, the code is left as it is.
generator : OPENCURLY COLON exprseq { bison_cxt->pushToGenerator($3, 1); } COMMA qual CLOSECURLY
			{
				PyrSlotNode* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(getsym("r")));
				PyrParseNode *block = bison_cxt->allocParseNode<PyrBlockNode>(@$, nullptr, nullptr, $6, false);
				PyrParseNode *blocklit = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, blocklit, nullptr);
			}
		| OPENCURLY SEMICOLON exprseq { bison_cxt->pushToGenerator($3, 2); } COMMA qual CLOSECURLY
			{ $$ = $6; };

nextqual	: %empty
				{
					// innermost part
					const auto [expr, action] = bison_cxt->popFromGenerator();
					if (action == 1) 
						$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(getsym("yield"))), expr, nullptr);
					else if (action == 2)
						$$ = expr; 
					// if action is neither, then what?
				}
			| COMMA qual 
				{ $$ = $2; };

qual	: name LEFTARROW exprseq nextqual
			{
				// later should check if exprseq is a series and optimize it to for loop
				
				auto* var = bison_cxt->allocParseNode<PyrVarDefNode>(@1, $1, nullptr, ReadWriteAccessor::Private);
				auto* args = bison_cxt->allocParseNode<PyrArgListNode>(@1, var, nullptr, nullptr);
				auto *block = bison_cxt->allocParseNode<PyrBlockNode>(@1, args, nullptr, $4, false);
				auto *blocklit = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);
				if (auto* call = nodeCast<PyrCallNode>($3); call && call->mSelector->mSlot.getSymbol() == s_series) {
						call->mSelector->mSlot = PyrSlot::make(getsym("forSeries"));
						call->mArglist = linkNodes(call->mArglist, blocklit);
						$$ = call;
				} else {
					auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@3, PyrSlot::make(getsym("do")));
					$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($3, blocklit), nullptr);
				}
			}
		| name name LEFTARROW exprseq nextqual
			{
				auto* call = nodeCast<PyrCallNode>($4);
				const auto is_series = call ? (call->mSelector->mSlot.getSymbol() == s_series) : false;

				auto* var1 = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $1, nullptr, ReadWriteAccessor::Private);
				auto* var2 = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $2, nullptr, ReadWriteAccessor::Private);
				auto* args = bison_cxt->allocParseNode<PyrArgListNode>(@$, linkNodes(var1, var2), nullptr, nullptr);
				auto *block = bison_cxt->allocParseNode<PyrBlockNode>(@$, args, nullptr, $5, false);
				auto *blocklit = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);

				if (auto* call = nodeCast<PyrCallNode>($3); call && call->mSelector->mSlot.getSymbol() == s_series) {
					call->mSelector->mSlot = PyrSlot::make(getsym("forSeries"));
					call->mArglist = linkNodes(call->mArglist, blocklit);
					$$ = call;
				} else {
					auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@3, PyrSlot::make(getsym("do")));
					$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, linkNodes($4, blocklit), nullptr);
				}
			}
		| VAR name EQUALSSIGN exprseq nextqual
			{
				PyrSlot slot = PyrSlot::make(s_value);
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, slot);
				auto* var = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $2, nullptr, ReadWriteAccessor::Private);
				auto* args = bison_cxt->allocParseNode<PyrArgListNode>(@$, var, nullptr, nullptr);
				auto *block = bison_cxt->allocParseNode<PyrBlockNode>(@$, args, nullptr, $5, false);
				auto *blocklit = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);
				$$ = bison_cxt->allocParseNode<PyrCallNode>(@$, selectornode, linkNodes(blocklit, $4), nullptr);
			}
		| exprseq nextqual
			{
				auto* selectornode = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(getsym("if")));
				auto* block = bison_cxt->allocParseNode<PyrBlockNode>(@$, nullptr, nullptr, $2, false);
				auto* blocklit = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>(block)), PyrParseNodeType::PushLitNode);
