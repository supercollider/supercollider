			| listlit2	{ $$ = bison_cxt->allocParseNode<PyrSlotNode>(@$, PyrSlot::make(static_cast<void*>($1)), PyrParseNodeType::LiteralNode); }

block	: OPENCURLY argdecls funcvardecls funcbody CLOSECURLY 
				{ $$ = bison_cxt->allocParseNode<PyrBlockNode>(@$, $2, $3, $4, false); }
		| BEGINCLOSEDFUNC argdecls funcvardecls funcbody CLOSECURLY 
				{ $$ = bison_cxt->allocParseNode<PyrBlockNode>(@$, $2, $3, $4, true); };

funcvardecls	: %empty { $$ = nullptr; }
				| funcvardecls funcvardecl
					{ $$ = linkNodes($1, $2); };

funcvardecls1	: funcvardecl
				| funcvardecls1 funcvardecl
					{ $$ = linkNodes($1, $2); };

funcvardecl	: VAR vardeflist SEMICOLON
				{ $$ = bison_cxt->allocParseNode<PyrVarListNode>(@$, $2, varLocal); };

argdecls	: %empty { $$ = nullptr; }
			| ARG vardeflist SEMICOLON
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, nullptr, nullptr); }
			| ARG vardeflist0 ELLIPSIS name SEMICOLON
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, $4, nullptr); }
			| ARG vardeflist0 ELLIPSIS name COMMA name SEMICOLON
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, $4, $6); }
			| PIPE slotdeflist PIPE
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, nullptr, nullptr); }
			| PIPE slotdeflist0 ELLIPSIS name PIPE
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, $4, nullptr); }
			| PIPE slotdeflist0 ELLIPSIS name COMMA name PIPE
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, $4, $6); };

argdecls1	: ARG vardeflist SEMICOLON
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, nullptr, nullptr); }
			| ARG vardeflist0 ELLIPSIS name SEMICOLON
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, $4, nullptr); }
			| ARG vardeflist0 ELLIPSIS name COMMA name SEMICOLON
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, $4, $6); }
			| PIPE slotdeflist PIPE
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, nullptr, nullptr); }
			| PIPE slotdeflist0 ELLIPSIS name PIPE
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, $4, nullptr); }
			| PIPE slotdeflist0 ELLIPSIS name COMMA name PIPE
				{ $$ = bison_cxt->allocParseNode<PyrArgListNode>(@$, $2, $4, $6); };

constdeflist	: constdef
				| constdeflist optcomma constdef
					{ $$ = linkNodes($1, $3); } ;

constdef	: rspec name EQUALSSIGN slotliteral
				{ $$ = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $2, $4, $1); };

slotdeflist0 	: %empty { $$ = nullptr; }
				| slotdeflist;

slotdeflist	: slotdef
			| slotdeflist optcomma slotdef
				{ $$ = linkNodes($1, $3); };

slotdef		: name
				{ $$ = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $1, nullptr, ReadWriteAccessor::Private); }
			| name optequal slotliteral
				{ $$ = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $1, $3, ReadWriteAccessor::Private); }
			| name optequal OPENPAREN exprseq CLOSEPAREN
				{
					PyrParseNode* node = $4;
					node->mParens = 1;
					$$ = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $1, node, ReadWriteAccessor::Private);
				};

vardeflist0 	: %empty  { $$ = nullptr; }
				| vardeflist;

vardeflist      : vardef
				| vardeflist COMMA vardef
					{ $$ = linkNodes($1, $3); };

vardef          : name
					{ $$ = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $1, nullptr, ReadWriteAccessor::Private); }
				| name EQUALSSIGN expr
					{ $$ = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $1, $3, ReadWriteAccessor::Private); }
				| name OPENPAREN exprseq CLOSEPAREN
					{
						PyrParseNode* node = $3;
						node->mParens = 1;
						$$ = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $1, node, ReadWriteAccessor::Private);
					};

dictslotdef	: exprseq COLON exprseq
				{ $$ = linkNodes($1, $3); }
			| KEYBINOP exprseq
				{ $$ = linkNodes($1->changeLiteralType<PyrParseNodeType::PushLitNode>(), $2); };

dictslotlist1	: dictslotdef
				| dictslotlist1 COMMA dictslotdef
					{ $$ = linkNodes($1, $3); } ;

dictslotlist	: %empty { $$ = nullptr; }
				| dictslotlist1 optcomma ;

rwslotdeflist	: rwslotdef
				| rwslotdeflist COMMA rwslotdef
					{ $$ = linkNodes($1, $3); };

rwslotdef		: rwspec name
					{ $$ = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $2, nullptr, $1); }
				| rwspec name EQUALSSIGN slotliteral
					{ $$ = bison_cxt->allocParseNode<PyrVarDefNode>(@$, $2, $4, $1); };

listlit	: HASH OPENSQUARE literallistc CLOSESQUARE
				{ $$ = bison_cxt->allocParseNode<PyrLitListNode>(@$, nullptr, $3); }
		| HASH CLASSNAME  OPENSQUARE literallistc CLOSESQUARE
				{ $$ = bison_cxt->allocParseNode<PyrLitListNode>(@$, $2, $4); };

listlit2	: OPENSQUARE literallistc CLOSESQUARE
				{ $$ = bison_cxt->allocParseNode<PyrLitListNode>(@$, nullptr, $2); }
			| CLASSNAME  OPENSQUARE literallistc CLOSESQUARE
				{ $$ = bison_cxt->allocParseNode<PyrLitListNode>(@$, $1, $3); };

literallistc	: %empty { $$ = nullptr; }
				| literallist1 optcomma;

literallist1	: listliteral
				| literallist1 COMMA listliteral
					{ $$ = linkNodes($1, $3); };

rwspec	: %empty { $$ = ReadWriteAccessor::Private; }
		| LESSTHAN { $$ = ReadWriteAccessor::Read; }
		| READWRITEVAR { $$ = ReadWriteAccessor::ReadWrite; }
		| GREATERTHAN { $$ = ReadWriteAccessor::Write; };

rspec	: %empty { $$ = ReadWriteAccessor::Private; } 
		| LESSTHAN { $$ = ReadWriteAccessor::Read; };

integer	: INTEGER 
		| MINUS INTEGER %prec UMINUS 
			{
				const auto v = $2->mSlot.getInt();
				$2->mSlot = PyrSlot::make(-v);
				$$ = $2;
			};

floatr	: SC_FLOAT 
		| MINUS SC_FLOAT %prec UMINUS 
			{
				const double v = $2->mSlot.getDouble();
				$2->mSlot = PyrSlot::make(-v);
				$$ = $2;
			};

accidental : ACCIDENTAL 
			| MINUS ACCIDENTAL %prec UMINUS 
				{
					const double in = $2->mSlot.getDouble();
					const double intval = floor(in + 0.5);
					const double fracval = in - intval;
					$2->mSlot = PyrSlot::make(-intval + fracval);
					$$ = $2;
				};

floatp	: floatr
		| accidental
		| floatr PIE 
			{
				$1->mSlot = PyrSlot::make($1->mSlot.getDouble() * pi);
				$1->location = @$;
				$$ = $1;
			}
		| integer PIE 
			{
				$1->mSlot = PyrSlot::make($1->mSlot.getInt() * pi);
				$1->location = @$;
				$$ = $1;
			}
		| PIE 
		| MINUS PIE 
			{
				$2->mSlot = PyrSlot::make(-pi);
				$2->location = @$;
				$$ = $2;
			};

name 		: NAME 
			| WHILE;

binop	: BINOP 
		| READWRITEVAR 
		| LESSTHAN 
		| GREATERTHAN 
		| MINUS 
		| MULTIPLY 
		| ADD 
		| PIPE;

binop2 	: binop 
		| KEYBINOP;

curryArg : CURRYARG { $$ = bison_cxt->allocParseNode<PyrCurryArgNode>(@$); }
